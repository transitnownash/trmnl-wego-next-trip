{%- capture warning_svg %}
<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
  <polygon points="10,2 19,18 1,18" fill="white" stroke="#222" stroke-width="1.5"/>
  <text x="10" y="15" text-anchor="middle" font-size="13" font-family="Arial, sans-serif" fill="#222" font-weight="bold">!</text>
</svg>
{% endcapture %}

{% template alert %}
<div class="item gap--small" data-sort="{{ alert.alert.informed_entity.first.route_id | default: 99999 }}">
  <div class="title text--white bg--black text--center w--10 flex--center-y">
    <span class="text--white">{{ alert.alert.informed_entity.first.route_id }}</span>
  </div>
  <div class="content">
    <div><span class="label label--small">{{ alert.alert.header_text.translation.first.text }}</span></div>
    <div class="flex gap--small">
      <span class="label label--small label--outline">{{ alert.alert.cause }}, {{ alert.alert.effect }}</span>
      {% if alert.alert.active_period.first.end < 32503701600 %}
      <span class="label label--small label--outline">{{ alert.alert.active_period.first.start | date: '%-m/%-d' }} thru {{ alert.alert.active_period.first.end | date: '%-m/%-d' }}</span>
      {% else %}
      <span class="label label--small label--outline">Start: {{ alert.alert.active_period.first.start | date: '%-m/%-d' }}</span>
      {% endif %}
      </span>
    </div>
  </div>
</div>
{% endtemplate %}

<style>
  .wego-map-canvas {
    border-radius: 10px;
  }
  .leaflet-tile-loaded {
    opacity: 0.1;
    filter: grayscale(1.0);
  }
  .screen--dark-mode .leaflet-tile-loaded {
    filter: invert();
  }
</style>

<script>
  (function () {
    const thunderforestApiKey = {{ trmnl.plugin_settings.custom_fields_values.thunderforest_api_key | json }};
    const busMarkerImage = 'data:image/svg+xml;base64,{{ bus_svg | base64_encode }}';

    // Map data
    const stop = {{ stop | json }};
    const vehiclePositions = {{ vehicle_positions | json }};

    // Pre-calculated trip data from Liquid
    const nextTrip = {{ next_trip | json }};

    const createRouteLine = (shape, color, weight) => {
      if (!shape || !shape.points) return null;
      const formattedShapePoints = shape.points.map((s) => [s.lat, s.lon]);
      return L.polyline(formattedShapePoints, { smooth: true, color, weight });
    };

    const addLeafletAssetsIfNeeded = (onReady) => {
      if (window.L) {
        onReady();
        return;
      }

      window.__wegoLeafletReadyQueue = window.__wegoLeafletReadyQueue || [];
      window.__wegoLeafletReadyQueue.push(onReady);

      if (window.__wegoLeafletLoadingStarted) {
        return;
      }
      window.__wegoLeafletLoadingStarted = true;

      if (!document.querySelector('link[data-wego-leaflet-css]')) {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        css.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
        css.crossOrigin = '';
        css.setAttribute('data-wego-leaflet-css', 'true');
        document.head.appendChild(css);
      }

      const existingJs = document.querySelector('script[data-wego-leaflet-js]');
      if (existingJs) {
        existingJs.addEventListener('load', () => {
          const queue = window.__wegoLeafletReadyQueue || [];
          window.__wegoLeafletReadyQueue = [];
          queue.forEach((cb) => cb());
        }, { once: true });
        return;
      }

      const js = document.createElement('script');
      js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      js.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      js.crossOrigin = '';
      js.setAttribute('data-wego-leaflet-js', 'true');
      js.addEventListener('load', () => {
        const queue = window.__wegoLeafletReadyQueue || [];
        window.__wegoLeafletReadyQueue = [];
        queue.forEach((cb) => cb());
      }, { once: true });
      document.head.appendChild(js);
    };

    const initializeMapCard = () => {
      const mapContainer = document.querySelector('.wego-map-canvas:not([data-wego-map-initialized])');
      if (!mapContainer) return;
      mapContainer.setAttribute('data-wego-map-initialized', 'true');

      const map = L.map(mapContainer, {
        center: [36.1627, -86.7816],
        zoom: 12,
        zoomControl: false,
        attributionControl: false
      });

      if (thunderforestApiKey && !thunderforestApiKey.includes('THUNDERFOREST_API_KEY')) {
        L.tileLayer('https://{s}.tile.thunderforest.com/mobile-atlas/{z}/{x}/{y}{r}.png?apikey={apikey}', {
          attribution: '&copy; <a href="http://www.thunderforest.com/">Thunderforest</a>, &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          apikey: thunderforestApiKey,
          maxZoom: 19
        }).addTo(map);
      } else {
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          maxZoom: 19,
          ext: 'png'
        }).addTo(map);
      }

      if (nextTrip?.trip?.shape && nextTrip.trip.route) {
        const routeShapeOutline = createRouteLine(nextTrip.trip.shape, '#ffffff', 16);
        const routeShape = createRouteLine(nextTrip.trip.shape, `#${nextTrip.trip.route.route_color}`, 8);
        if (routeShapeOutline) routeShapeOutline.addTo(map);
        if (routeShape) {
          routeShape.addTo(map);
          map.fitBounds(routeShape.getBounds());
        }
      }

      L.circleMarker([parseFloat(stop.stop_lat), parseFloat(stop.stop_lon)], {
        radius: 8,
        color: '#fff',
        weight: 3,
        fillColor: '#000',
        fillOpacity: 1
      }).addTo(map);

      const vehicle = vehiclePositions.find((vp) => vp.trip?.trip_id === nextTrip?.trip?.trip_gid);
      if (vehicle) {
        L.marker([parseFloat(vehicle.position.latitude), parseFloat(vehicle.position.longitude)], {
          icon: L.icon({
            iconUrl: busMarkerImage,
            iconSize: [20, 20],
            iconAnchor: [10, 10]
          }),
          zIndexOffset: 1000
        }).addTo(map);
      }

      setTimeout(() => map.invalidateSize(), 0);
    };

    const bootstrap = () => addLeafletAssetsIfNeeded(initializeMapCard);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
      bootstrap();
    }
  })();
</script>

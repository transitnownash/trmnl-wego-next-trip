</svg>
{% endcapture %}

{% template alert %}
<div class="item gap--small" data-sort="{{ alert.alert.informed_entity.first.route_id | default: 99999 }}">
  <div class="title text--white bg--black text--center w--10 flex--center-y">
    <span class="text--white">{{ alert.alert.informed_entity.first.route_id }}</span>
  </div>
  <div class="content">
    <div><span class="label label--small">{{ alert.alert.header_text.translation.first.text }}</span></div>
    <div class="flex gap--small">
      <span class="label label--small label--outline">{{ alert.alert.cause }}, {{ alert.alert.effect }}</span>
      {% if alert.alert.active_period.first.end < 32503701600 %}
      <span class="label label--small label--outline">{{ alert.alert.active_period.first.start | date: '%-m/%-d' }} thru {{ alert.alert.active_period.first.end | date: '%-m/%-d' }}</span>
      {% else %}
      <span class="label label--small label--outline">Start: {{ alert.alert.active_period.first.start | date: '%-m/%-d' }}</span>
      {% endif %}
      </span>
    </div>
  </div>
</div>
{% endtemplate %}

<link href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css" rel="stylesheet">
<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>

<script>
  (function () {
    const busMarkerImage = 'data:image/svg+xml;base64,{{ bus_svg | base64_encode }}';

    // Map data
    const stop = {{ stop | json }};
    const vehiclePositions = {{ vehicle_positions | json }};

    // Pre-calculated trip data from Liquid
    const nextTrip = {{ next_trip | json }};

    const whenReady = (cb) => {
      let tries = 0;
      (function attempt() {
        if (window.TRMNLMaps && window.maplibregl) return cb();
        if (++tries > 200) return;
        setTimeout(attempt, 50);
      })();
    };

    const initializeMapCard = () => {
      const el = document.querySelector('.wego-map-canvas:not([data-wego-map-initialized])');
      if (!el) return;
      el.setAttribute('data-wego-map-initialized', 'true');

      const shapeCoords = (nextTrip?.trip?.shape?.points || []).map((p) => [parseFloat(p.lon), parseFloat(p.lat)]);

      // TRMNLMaps.route renders sub-pixel segments with gaps, so thin points relative to the route's extent
      const routeCoords = [];
      if (shapeCoords.length >= 2) {
        const xs = shapeCoords.map((c) => c[0]);
        const ys = shapeCoords.map((c) => c[1]);
        const minStep = Math.max(Math.max(...xs) - Math.min(...xs), Math.max(...ys) - Math.min(...ys)) / 120;
        routeCoords.push(shapeCoords[0]);
        shapeCoords.slice(1, -1).forEach((c) => {
          const last = routeCoords[routeCoords.length - 1];
          if (Math.hypot(c[0] - last[0], c[1] - last[1]) >= minStep) routeCoords.push(c);
        });
        routeCoords.push(shapeCoords[shapeCoords.length - 1]);
      }
      const stopCoord = [parseFloat(stop.stop_lon), parseFloat(stop.stop_lat)];
      const vehicle = vehiclePositions.find((vp) => vp.trip?.trip_id === nextTrip?.trip?.trip_gid);

      TRMNLMaps.watch(el, () => {
        // Streets preset minus area fills (parks, land use, sites) for a flat, roads-only look
        const keepLayer = /^(background|ocean|water|water-lines|roads-(minor|major)(-casing)?)$/;
        const style = TRMNLMaps.style('streets', { el, buildings: false, labels: 'major' });
        style.layers = style.layers.filter((l) => keepLayer.test(l.id));
        style.metadata['trmnl:shapes'] = style.metadata['trmnl:shapes'].filter((s) => keepLayer.test(s.id));

        const map = new maplibregl.Map(TRMNLMaps.options({ el, style, center: stopCoord, zoom: 15 }));

        map.on('load', () => {
          if (routeCoords.length >= 2) TRMNLMaps.route(map, routeCoords, { el, id: 'trip', width: 6 });
          TRMNLMaps.dot(map, stopCoord, { el, id: 'stop', radius: 6 });
        });

        if (vehicle) {
          const size = TRMNLPaint.px(20, { el });
          const img = document.createElement('img');
          img.src = busMarkerImage;
          img.width = size;
          img.height = size;
          img.style.zIndex = '2';
          new maplibregl.Marker({ element: img, anchor: 'center' })
            .setLngLat([parseFloat(vehicle.position.longitude), parseFloat(vehicle.position.latitude)])
            .addTo(map);
        }

        if (routeCoords.length >= 2) {
          TRMNLMaps.fit(map, routeCoords, { padding: TRMNLPaint.px(16, { el }), maxZoom: 16 });
        }

        return map;
      });
    };

    const bootstrap = () => whenReady(initializeMapCard);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
      bootstrap();
    }
  })();
</script>

{%- capture warning_svg %}
<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
  <polygon points="10,2 19,18 1,18" fill="white" stroke="#222" stroke-width="1.5"/>
